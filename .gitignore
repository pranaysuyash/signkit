# Node (if any legacy files)
node_modules/
# The repository has no root package.json, so an orphan root lockfile remains
# local tooling output. The tracked web/e2e package does have a package
# manifest, so its lockfile is part of the reproducible test toolchain.
package-lock.json
yarn.lock
!web/e2e/package-lock.json

# Alembic
alembic/versions/*.pyc

# Code signing
*.provisionprofile
*.mobileprovision
*.cer
*.p12
*.certSigningRequest

# Local helper scripts (dev-only) - ignored on main and landing branches
tools/convert_images.py
tools/upload_to_cloudflare.py

# Keep generated landing test artifacts out of git now that `main` owns the landing page
/web/backups/*
!/web/backups/README.md
/web/e2e/test-results/
/web/e2e/playwright-report/
/web/e2e/**/specs/*-snapshots/
/web/e2e/.wrangler/

# Calibration datasets (generated, internal-use only). Commit the small
# manifests, reports, and provenance notes. Regenerate the PNG/PDF assets from
# the recorded manifest metadata; never commit those generated binaries.
/datasets/*
!/datasets/image_signatures/
!/datasets/pdf_fields/
!/datasets/image_signatures/manifest.json
!/datasets/image_signatures/calibration_report_*.json
!/datasets/image_signatures/notes.md
!/datasets/pdf_fields/manifest.json
!/datasets/pdf_fields/calibration_report_*.json
!/datasets/pdf_fields/notes.md
/datasets/image_signatures/images/
/datasets/pdf_fields/pdfs/
